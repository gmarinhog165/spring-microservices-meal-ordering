# Copiar para .env e preencher. O .env não vai para o git.
#   cp .env.example .env

# --- Postgres da aplicação ---
POSTGRES_DB=foodordering
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me

# --- Postgres do Keycloak ---
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Secret do cliente confidencial `auth-service`.
# O realm em docker/keycloak/realms/ importa este valor via ${KEYCLOAK_CLIENT_SECRET},
# por isso é este ficheiro que o define — não a consola do Keycloak.
# Tem de coincidir com `keycloak.client-secret` em auth-service/src/main/resources/
# application.properties para o `./gradlew bootRun` continuar a funcionar contra este stack.
KEYCLOAK_CLIENT_SECRET=change-me

# Cliente `food-client-id`: existe no realm mas nenhum serviço o usa hoje.
KEYCLOAK_FOOD_CLIENT_SECRET=change-me

# --- Imagens ---
# Em local ficam como foodordering/<servico>:local.
# Para AWS: REGISTRY=<account>.dkr.ecr.<region>.amazonaws.com  TAG=<git-sha>
REGISTRY=foodordering
TAG=local
